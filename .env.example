# CrossCredit environment — copy to .env and fill in. NEVER commit .env.

# ─── RPCs ────────────────────────────────────────────────────────────────────
# Sepolia: use an Alchemy/Infura key — public RPCs rate-limit during seeding.
SEPOLIA_RPC_URL=
CC3_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# ─── Attestcoin Protocol ─────────────────────────────────────────────────────
# Hosted proof builder (alias: https://proof-gen-api.cc3-testnet.creditcoin.network/)
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network
# Creditcoin-internal source-chain id. 1 = Ethereum Sepolia on CC3 testnet.
# NOT the EVM chainId. Must match docs/evidence/supported-chains.json.
SOURCE_CHAIN_KEY=1

# ─── Keys — TEST-ONLY wallet, never real funds ───────────────────────────────
DEPLOYER_PRIVATE_KEY=
DEMO_BORROWER_ADDRESS=

# Free key from https://etherscan.io/apis — used to verify LoanBook's source on Sepolia.
# Optional: `forge verify-contract --verifier sourcify` needs no key.
ETHERSCAN_API_KEY=

# ─── Deployed addresses (filled in as each phase deploys) ────────────────────
LOANBOOK_ADDRESS=
CREDIT_REGISTRY_ADDRESS=
TIER_SBT_ADDRESS=
LENDING_POOL_ADDRESS=
TUSD_ADDRESS=
