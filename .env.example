# CrossCredit environment — copy to .env and fill in. NEVER commit .env.
#
# The deployed addresses below are already filled in with our live testnet deployment, so the
# read-only scripts (check:chains, negative-paths, capture:proof) work as soon as you set
# SEPOLIA_RPC_URL. A private key is only needed to send transactions.

# ─── RPCs ────────────────────────────────────────────────────────────────────
# Any Sepolia endpoint works for reads. A free Alchemy/Infura key is worth it for the seeding
# script, which sends ~10 transactions; public endpoints rate-limit.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CC3_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# ─── Attestcoin Protocol ─────────────────────────────────────────────────────
# Hosted proof builder (alias: https://proof-gen-api.cc3-testnet.creditcoin.network/)
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network
# Creditcoin-internal source-chain id. 1 = Ethereum Sepolia on CC3 testnet.
# NOT the EVM chainId. Must match docs/evidence/supported-chains.json.
SOURCE_CHAIN_KEY=1

# ─── Keys — TEST-ONLY wallet, never real funds ───────────────────────────────
# Only needed to SEND transactions (deploying, seeding, importing history).
# Every read-only script works without it. Faucets: Creditcoin Discord token-faucet
# (/faucet address:0x…) for tCTC; any public Sepolia faucet for the source side.
DEPLOYER_PRIVATE_KEY=
DEMO_BORROWER_ADDRESS=0x8C04C28894BADcE63d1F00f356AbB126983522Cf

# Free key from https://etherscan.io/apis — only used to verify contract source on Sepolia.
ETHERSCAN_API_KEY=

# ─── Deployed contracts (live testnet — see deployments.json) ────────────────
# Ethereum Sepolia
LOANBOOK_ADDRESS=0x07AdA5C60dFbe5C3A7dC48081B0fa70E14c6d41D
# Creditcoin CC3 testnet — keep in step with deployments.json. This block has gone stale after a
# redeploy TWICE now (Phase 3, then the v2 flash-loan-guard generation), each time leaving a
# fresh clone silently running against a paused registry. CI now diffs these against
# deployments.json (scripts/check-env-example.ts); if that check is failing, trust deployments.json.
CREDIT_REGISTRY_ADDRESS=0x4C4381dB68a1cAAE46a2E6CFc2f667ad22Dddf81
TIER_SBT_ADDRESS=0x326F8806cBd5ABF413889BfAc0A6622a0AEddD18
LENDING_POOL_ADDRESS=0xf27877faC13244a4ad959E83cD9E5a15d919029C
TUSD_ADDRESS=0x26FEEdECb79A69EdC7d3Bdb8Cf4dD96E17a3B051

# ─── Demo wallets ────────────────────────────────────────────────────────────
# Borrower C needs no key here. `scripts/seed-borrower-c.ts` generates a fresh wallet each run,
# funds it, seeds its history and discards the key — it is never printed and never written to
# disk, so there is nothing to leak and nothing to rotate. Re-seeding simply makes a new one.
#
# An earlier version wrote that key into docs/evidence/borrower-c-history.json, which is a
# committed artifact, and so published it. The CI `secret scan` job now fails on any such file.
