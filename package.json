{
  "name": "crosscredit",
  "version": "0.1.0",
  "private": true,
  "description": "Trustless cross-chain credit reputation and lending on Creditcoin, via the Attestcoin Protocol",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "test:ci": "FOUNDRY_PROFILE=ci forge test",
    "check:chains": "tsx scripts/check-chains.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "capture:proof": "tsx scripts/capture-proof.ts",
    "seed:history": "tsx scripts/seed-history.ts",
    "deploy:loanbook": "forge script contracts/script/DeployLoanBook.s.sol:DeployLoanBook --rpc-url $SEPOLIA_RPC_URL --broadcast",
    "worker:watch": "tsx worker/index.ts watch",
    "worker:backfill": "tsx worker/index.ts backfill",
    "seed:borrower-c": "tsx scripts/seed-borrower-c.ts",
    "worker:batch": "tsx worker/index.ts batch",
    "negative-paths": "tsx scripts/negative-paths.ts"
  },
  "dependencies": {
    "@gluwa/usc-contracts": "0.1.2",
    "@gluwa/usc-sdk": "0.18.0",
    "@openzeppelin/contracts": "5.4.0",
    "dotenv": "^17.2.3",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "forge-std": "github:foundry-rs/forge-std#v1.9.7",
    "prettier": "^3.4.2",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
